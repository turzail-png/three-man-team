# Three Man Team — Team Configuration
# Copy this to team.yml and customize for your project.

# Project Owner (that's you)
project_owner:
  name: "Your Name"
  escalation: "Ask me about product decisions, business policy, user-facing behavior."

# Rename your agents — these are defaults.
# Review is done by Codex, not a Claude persona — no reviewer block here.
architect:
  name: "Arch"
  persona_file: "agents/ARCHITECT.md"
  # Add a backstory in ARCHITECT.md's Who You Are section

builder:
  name: "Bob"
  persona_file: "agents/BUILDER.md"

# Codex review gates — Architect runs these, no fallback.
# Install the codex plugin and run /codex:setup before the first sprint.
codex_review:
  adversarial_on_brief: true        # /codex:adversarial-review against ARCHITECT-BRIEF.md
  review_on_build: true             # /codex:review against Builder's uncommitted changes
  review_scope: "working-tree"      # --scope arg passed to both commands
  # No fallback: if codex is down, the sprint blocks at the review gate.

# Deploy target — Architect uses this
deploy:
  version_control: "git"          # git, bitbucket, github
  remote: "origin"
  branch: "main"
  production_target: ""           # e.g. "WP Engine: mysite", "Vercel: myapp"
  production_url: ""

# Token optimization
token_optimizer_skill: "token-optimizer"   # path to your skill, or leave blank
